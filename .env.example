# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (optional — demo seed + memory store works without)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Qwen via ModelScope (preferred for policy plain-language — server-side only)
QWEN_API_KEY=
QWEN_BASE_URL=https://api-inference.modelscope.ai/v1
QWEN_MODEL=Qwen-Ambassador/Qwen3.8-plus

# OpenRouter + Gemma (optional fallback if Qwen is not set)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-2-9b-it:free

# Moderator dashboard (/moderate?key=...)
ELMA_MODERATOR_KEY=
